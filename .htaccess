# Beveiligingsinstellingen voor Apache en LiteSpeed (gebruikt door de meeste
# Nederlandse webhosters).
Options -Indexes

# Bestanden die niet bedoeld zijn voor bezoekers.
RedirectMatch 404 /\.(git|github)(/|$)
RedirectMatch 404 /tests(/|$)
<FilesMatch "\.(md|mjs|sql|yml|json)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Niet opnemen in zoekmachines. Bewust GEEN robots.txt met Disallow:
    # dan zien zoekmachines deze noindex niet en kan het adres toch
    # (zonder inhoud) in de zoekresultaten komen.
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# Altijd de nieuwste versie van de app laden. De hoster laat browsers
# JavaScript en CSS standaard 7 dagen bewaren zonder opnieuw te vragen; na een
# nieuwe versie draaide de browser dan nog dagen de oude code, soms half oud en
# half nieuw. Met no-cache vraagt de browser bij elk bezoek of het bestand
# veranderd is; is het hetzelfde, dan komt er alleen een kort antwoord terug.
<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>
<FilesMatch "\.(html|js|css)$">
    <IfModule mod_headers.c>
        Header unset Expires
        Header set Cache-Control "no-cache"
    </IfModule>
</FilesMatch>

# Zet HTTPS afdwingen bij voorkeur aan in het controlepaneel van de hoster.
# Kan dat daar niet, haal dan het hekje weg voor de drie regels hieronder.
# RewriteEngine On
# RewriteCond %{HTTPS} !=on
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
